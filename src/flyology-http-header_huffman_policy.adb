     (Value   : Ada.Streams.Stream_Element_Array;
      Maximum : Output_Length) return Decode_Result
   is
      Result   : Decode_Result;
      Cursor   : Node_Index := 0;
      Bits     : Natural range 0 .. 30 := 0;
      All_Ones : Boolean := True;
