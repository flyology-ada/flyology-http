      for Octet of Value loop
         pragma Loop_Invariant (Result.Length <= Maximum);
         for Position in reverse Natural range 0 .. 7 loop
            pragma Loop_Invariant (Result.Length <= Maximum);
            declare
               Bit : constant Interfaces.Unsigned_8 :=
                 Interfaces.Shift_Right
                   (Interfaces.Unsigned_8 (Octet), Position) and 1;
               Next : constant Extended_Node_Index :=
                 (if Bit = 0
                  then Nodes (Cursor).Zero
                  else Nodes (Cursor).One);
            begin
               if Next = No_Node or else Bits = 30 then
                  Result.Status := Invalid_Code;
                  return Result;
               end if;
               Cursor := Node_Index (Next);
               Bits := Bits + 1;
               All_Ones := All_Ones and then Bit = 1;
            end;

            if Nodes (Cursor).Symbol /= No_Symbol then
               if Nodes (Cursor).Symbol = 256 then
                  Result.Status := EOS_Symbol;
                  return Result;
               elsif Result.Length = Maximum then
                  Result.Status := Output_Too_Large;
                  return Result;
               end if;
               pragma Assert (Result.Length < Maximum);
               Result.Length := Result.Length + 1;
               Result.Data (Result.Length) :=
                 Character'Val (Nodes (Cursor).Symbol);
               Cursor := 0;
               Bits := 0;
               All_Ones := True;
            end if;
         end loop;
      end loop;

      if Bits > 7 or else (Bits > 0 and then not All_Ones) then
         Result.Status := Invalid_Padding;
      else
         Result.Status := Decoded;
      end if;
      return Result;
   end Decode;
end Flyology.HTTP.Header_Huffman_Policy;
