project Flyology_IRI is
   type Build_Mode_Kind is ("checked", "release");
   Build_Mode : Build_Mode_Kind :=
     external ("FLYOLOGY_IRI_BUILD_MODE", "checked");

   for Languages use ("Ada");
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Library_Name use "Flyology_IRI";
   for Library_Dir use "lib";
   for Library_Kind use "static";
   for Create_Missing_Dirs use "True";

   package Compiler is
      case Build_Mode is
         when "checked" =>
            for Default_Switches ("Ada") use
              ("-gnat2022", "-O3", "-gnatn2", "-gnatwJ", "-gnatwa");
         when "release" =>
            for Default_Switches ("Ada") use
              ("-gnat2022", "-O3", "-gnatn2", "-gnatp", "-gnatwJ", "-gnatwa");
      end case;
   end Compiler;

   package Documentation is
      for Output_Dir ("html") use "docs/api";
   end Documentation;
end Flyology_IRI;
