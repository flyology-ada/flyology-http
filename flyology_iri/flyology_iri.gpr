project Flyology_IRI is
   type Build_Mode_Kind is ("checked", "release");
   Build_Mode : Build_Mode_Kind :=
     external ("FLYOLOGY_IRI_BUILD_MODE", "checked");

   for Languages use ("Ada");
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Library_Name use "Flyology_IRI";
   for Library_Dir use "lib";
   for Library_Kind use "static";
   for Create_Missing_Dirs use "True";

   package Compiler is
      Common := ("-gnat2022", "-O3", "-gnatn2", "-gnatwJ", "-gnatwa");
      for Default_Switches ("Ada") use Common;

      case Build_Mode is
         when "checked" =>
            null;
         when "release" =>
            --  Release suppresses runtime checks in this one body, whose
            --  index arithmetic over plain String is what the published
            --  medians measure. Nothing discharges those obligations, so
            --  proof/proof-status.md records them as an open obligation and
            --  the checked default keeps every check on for test and fuzz
            --  builds. The WHATWG serialization and IDNA bodies keep their
            --  checks in every mode: measurement showed suppressing them
            --  buys nothing, and they are the bodies that decode percent
            --  escapes, punycode, and IP literals.
            for Switches ("flyology_iri.adb") use Common & ("-gnatp");
      end case;
   end Compiler;

   package Documentation is
      for Output_Dir ("html") use "docs/api";
      for Resources_Dir ("html") use "docs/gnatdoc/html";
   end Documentation;
end Flyology_IRI;
