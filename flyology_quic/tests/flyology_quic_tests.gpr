with "flyology_quic";

project Flyology_QUIC_Tests is
   for Languages use ("Ada");
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use
     ("flyology-quic-application_connection-smoke.adb",
      "flyology-quic-connection_state_policy-smoke.adb",
      "flyology-quic-crypto_frame_policy-smoke.adb",
      "flyology-quic-crypto_openssl-smoke.adb",
      "flyology-quic-crypto_reassembly_policy-smoke.adb",
      "flyology-quic-handshake_connection-smoke.adb",
      "flyology-quic-handshake_packet_policy-smoke.adb",
      "flyology-quic-handshake_sender-smoke.adb",
      "flyology-quic-http_3_control_policy-smoke.adb",
      "flyology-quic-http_3_frame_policy-smoke.adb",
      "flyology-quic-http_3_settings_policy-smoke.adb",
      "flyology-quic-http_3_stream_policy-smoke.adb",
      "flyology-quic-initial_frame_policy-smoke.adb",
      "flyology-quic-initial_connection-smoke.adb",
      "flyology-quic-initial_receiver-smoke.adb",
      "flyology-quic-initial_sender-smoke.adb",
      "flyology-quic-initial_packet_policy-smoke.adb",
      "flyology-quic-long_header_policy-smoke.adb",
      "flyology-quic-one_rtt_packet_policy-smoke.adb",
      "flyology-quic-one_rtt_sender-smoke.adb",
      "flyology-quic-packet_number_policy-smoke.adb",
      "flyology-quic-protection_policy-smoke.adb",
      "flyology-quic-qpack_integer_policy-smoke.adb",
      "flyology-quic-qpack_static_table-smoke.adb",
      "flyology-quic-stream_frame_policy-smoke.adb",
      "flyology-quic-tls_authentication_policy-smoke.adb",
      "flyology-quic-tls_extension_policy-smoke.adb",
      "flyology-quic-tls_handshake_policy-smoke.adb",
      "flyology-quic-tls_key_schedule-smoke.adb",
      "flyology-quic-tls_session-smoke.adb",
      "flyology-quic-tls_signature_policy-smoke.adb",
      "flyology-quic-tls_transport_smoke.adb",
      "flyology-quic-transport_parameter_policy-smoke.adb",
      "flyology-quic-varint_policy-smoke.adb");
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-O2", "-gnata", "-gnatVa", "-gnatwa", "-gnatwJ");
   end Compiler;
end Flyology_QUIC_Tests;
