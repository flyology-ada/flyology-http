with "../../flyology_http.gpr";
--  flyology_iri is a sibling crate that flyology_http does not with, so a
--  spike for it needs the project named here explicitly.
with "../../flyology_iri/flyology_iri.gpr";

--  Bug reproduction harness for the correctness review.  Built the same way
--  scripts/test.sh builds tests/http_tests.gpr: under `alr exec`, with
--  GPR_CONFIG unset, against the version-matched runtime prepared under
--  build/rts, and with its own --subdirs so it never shares an object
--  directory with the maintained suites.
--
--  Source_Dirs includes tests/ so a spike can use the barrier points in
--  flyology-io-connections-testing.ads, tls_test_provider.ads, and
--  flyology-quic-test_connections.ads exactly as the maintained tests do.
--
--  One main per invocation, named by -XMAIN, so a spike that fails to
--  compile never blocks another spike's run.
project Repros is
   Main_Name := external ("MAIN", "repro_smoke");

   for Languages use ("Ada", "C");
   for Source_Dirs use ("src", "..", "../native");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Create_Missing_Dirs use "True";
   for Main use (Main_Name & ".adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnatVa", "-gnatwa", "-gnatwJ");
      for Default_Switches ("C") use
        ("-std=c11", "-Wall", "-Wextra");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;
end Repros;
