with "flyology_http";
with "flyology_tla";

project SSE_Client_Conformance is

   for Languages use ("Ada");
   for Source_Dirs use ("src", "generated");
   for Object_Dir use "build/obj";
   for Exec_Dir use "bin";
   for Main use ("sse_client_conformance.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnatVa", "-gnatwa", "-gnatw.X", "-gnatyM110");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

   package Builder is
      for Executable ("sse_client_conformance.adb") use
        "sse-client-conformance";
   end Builder;

end SSE_Client_Conformance;
